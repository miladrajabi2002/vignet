# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/.codex-tmp/

# next.js
/.next/
/out/

# production
/build

# Runtime uploads and generated image-proxy cache belong in object storage,
# never in source control. The directory is still used as a local-dev and
# pre-object-storage migration fallback.
/public/uploads/products/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.bak*

# Retired WhatsApp bridge artifacts (may contain live session credentials)
/mini-services/whatsapp-bridge/

# prisma generated client
/lib/generated/prisma

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
