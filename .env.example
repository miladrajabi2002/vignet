# ─── Database (Supabase Postgres + pgvector) ───────────────────────
# Pooled connection (PgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# deploy/backup.sh prefers this unpooled URL and removes Prisma-only query
# options such as `schema` before passing it to pg_dump.

# ─── Auth (NextAuth v5) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 also reads AUTH_SECRET; keep them in sync
AUTH_SECRET=""
PUBLIC_CONVERSATION_SECRET=""

# Platform admin (server-only). ADMIN_TOTP_SECRET is a Base32 authenticator key.
ADMIN_OWNER_PHONE=""
ADMIN_OWNER_NAME=""
ADMIN_PASS=""
ADMIN_SESSION_SECRET=""
ADMIN_API_TOKEN=""
ADMIN_TOTP_SECRET=""
# Successful subscription purchases/renewals and AI-credit top-ups are sent
# here. Leave blank to use ADMIN_OWNER_PHONE (the canonical platform owner).
ADMIN_COMMERCIAL_SMS_PHONE=""

# ─── SMS / OTP (IPPanel — docs.ippanel.com) ────────────────────────
# IPPanel only accepts requests from an Iranian IP, but this app is hosted
# abroad — so sends are relayed through a small PHP proxy on Iranian shared
# hosting (see deploy/ippanel-proxy/index.php) instead of calling IPPanel
# directly. Set IPPANEL_PROXY_URL + IPPANEL_PROXY_SECRET below; the proxy
# holds the real IPPANEL_API_KEY, so leave IPPANEL_API_KEY blank here.
# (IPPANEL_API_KEY is only used as a fallback for calling IPPanel directly,
# e.g. from an Iranian dev machine or if the server ever moves to Iran.)
IPPANEL_API_KEY=""
# Full URL of the deployed PHP proxy, e.g. https://yourdomain.ir/script/vigent-otp/index.php
IPPANEL_PROXY_URL=""
# Shared secret — must match PROXY_SECRET in deploy/ippanel-proxy/index.php
IPPANEL_PROXY_SECRET=""
# Pattern code (پترن تاییدشده) containing a %code% variable. For Android
# auto-fill (WebOTP), end the pattern with the exact line:
#   @vigent.ir #%code%
IPPANEL_PATTERN_CODE=""
# Sender line number in E.164 format (e.g. +983000505). Used for both the
# OTP pattern and non-OTP notification SMS.
IPPANEL_FROM_NUMBER=""
# Security-sensitive observability switch. Development logs OTP codes by default.
# In production enable only while debugging; codes become visible in admin/process logs.
LOG_OTP_CODES="false"

# ─── Subscription SMS patterns (IPPanel) ───────────────────────────────
# Two SEPARATE pre-approved patterns (registered in IPPanel) for subscription
# notifications. They use the same pattern-mode sending as the OTP pattern
# above, but with their own code + variables so you can word each message
# independently. Leave blank to silently skip that notification (dev/sandbox).
#
# 1) Purchase confirmation — sent right after a payment is verified and the
#    subscription is activated (see lib/billing/entitlements.ts).
#    Variables: %plan% (plan name in Persian), %expiry% (Jalali end date).
#    Sample pattern to register in IPPanel:
#      اشتراک %plan% ویجنت با موفقیت فعال شد. معتبر تا: %expiry%
#      vigent.ir
IPPANEL_SUBSCRIPTION_PURCHASED_PATTERN_CODE=""
#
# 2) Expiry reminder — sent ~3 days before the subscription ends (see the
#    subscription-expiry sweep in worker/scheduler.ts).
#    Variables: %days% (whole days remaining), %expiry% (Jalali end date).
#    Sample pattern to register in IPPanel:
#      اشتراک ویجنت شما %days% روز دیگر منقضی می‌شود (%expiry%).
#      برای تمدید وارد حساب کاربری خود در vigent.ir شوید.
IPPANEL_SUBSCRIPTION_EXPIRING_PATTERN_CODE=""
#
# How many days before expiry the reminder fires (optional; default 3).
SUBSCRIPTION_REMIND_DAYS="3"

# ─── Admin commercial SMS patterns (IPPanel) ──────────────────────
# These three patterns notify the platform owner after a payment is durably
# verified. They are required in production and never fall back to free-text
# webservice SMS. Recipient: ADMIN_COMMERCIAL_SMS_PHONE, or ADMIN_OWNER_PHONE
# when the override is blank.
#
# 1) New subscription purchase
# Variables: %workspace% %owner% %phone% %plan% %amount% %gateway% %reference%
# Sample:
#   خرید اشتراک جدید ویجنت
#   کسب‌وکار: %workspace% — مدیر: %owner% (%phone%)
#   پلن: %plan% — مبلغ: %amount%
#   درگاه: %gateway% — پیگیری: %reference%
IPPANEL_ADMIN_SUBSCRIPTION_PURCHASED_PATTERN_CODE=""
#
# 2) Subscription renewal — variables are identical to purchase.
# Sample:
#   تمدید اشتراک ویجنت
#   کسب‌وکار: %workspace% — مدیر: %owner% (%phone%)
#   پلن: %plan% — مبلغ: %amount%
#   درگاه: %gateway% — پیگیری: %reference%
IPPANEL_ADMIN_SUBSCRIPTION_RENEWED_PATTERN_CODE=""
#
# 3) AI-credit top-up
# Variables: %workspace% %owner% %phone% %amount% %balance% %gateway% %reference%
# Sample:
#   افزایش اعتبار ویجنت
#   کسب‌وکار: %workspace% — مدیر: %owner% (%phone%)
#   مبلغ: %amount% — موجودی جدید: %balance%
#   درگاه: %gateway% — پیگیری: %reference%
IPPANEL_ADMIN_CREDIT_TOPPED_UP_PATTERN_CODE=""

# ─── Trial activation SMS patterns (IPPanel) ─────────────────────
# Welcome, next-step, activation-success and trial-expiry messages. These are
# SMS-only lifecycle messages; each pattern is deduplicated by the app.
#
# Variables: %name%
# Sample: %name% عزیز، به ویجنت خوش آمدید. ساخت اولین ایجنت کمتر از ۵ دقیقه زمان می‌برد. vigent.ir/onboarding
IPPANEL_WELCOME_PATTERN_CODE=""
# Variables: %step%
# Sample: گام بعدی راه‌اندازی ویجنت شما: %step% — ادامه در vigent.ir/onboarding
IPPANEL_ACTIVATION_REMINDER_PATTERN_CODE=""
# Variables: %status%
# Sample: ایجنت ویجنت شما %status% شد و آماده پاسخ‌گویی است. vigent.ir/overview
IPPANEL_ACTIVATION_COMPLETE_PATTERN_CODE=""
# Variables: %days%
# Sample: از دوره رایگان ویجنت شما %days% روز باقی مانده است. مشاهده پلن‌ها: vigent.ir/billing
IPPANEL_TRIAL_EXPIRING_PATTERN_CODE=""

# ─── Encryption (channel/integration secrets, AES-256-GCM) ────────
# 64 hex characters = 32 bytes. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Platform-managed AI (server only; never prefix with NEXT_PUBLIC_) ───
# One OpenRouter key owned by Vigent. Customers never enter or see this key.
OPENROUTER_API_KEY=""
# Optional management key: enables purchased/used/remaining account credit in /admin/ai.
# The normal API key still reports its own daily/weekly/monthly usage and limit.
OPENROUTER_MANAGEMENT_KEY=""
OPENROUTER_MODEL_FAST="deepseek/deepseek-v4-flash"
OPENROUTER_MODEL_BALANCED="openai/gpt-5.4-nano"
OPENROUTER_MODEL_STANDARD="google/gemini-3.1-flash-lite"
OPENROUTER_MODEL_PREMIUM="deepseek/deepseek-v4-pro"
OPENROUTER_STT_MODEL="openai/whisper-large-v3-turbo"
OPENROUTER_TTS_MODEL="openai/gpt-4o-mini-tts-2025-12-15"
OPENROUTER_PROVIDER_SORT="price"
OPENROUTER_ZDR="true"
# Fixed wallet charge per successful reply (IRR; UI displays toman ÷10).
AI_REPLY_PRICE_FAST_IRR="3000"
AI_REPLY_PRICE_STANDARD_IRR="4500"
AI_REPLY_PRICE_BALANCED_IRR="6500"
AI_REPLY_PRICE_PREMIUM_IRR="30000"
AI_TRIAL_CREDIT_IRR="100000"

# ─── Redis (BullMQ jobs + OTP storage) ─────────────────────────────
REDIS_URL="redis://localhost:6379"
# Set to 1 to process ingestion/embedding inline instead of via the worker
# (handy for dev so you don't need to run `npm run worker`).
DISABLE_QUEUE="0"

# ─── Object Storage (S3-compatible, self-hosted MinIO) ─────────────
# Set up automatically by deploy/setup-server.sh. For an external S3
# provider, point S3_ENDPOINT at it and fill the keys.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
# Main application bucket (defaults to knowledge when omitted).
S3_BUCKET="knowledge"
# Optional CDN/public origin used for uploaded Instagram media.
S3_PUBLIC_URL=""

# Independent off-site database backups (strongly recommended in production).
# Do not point this at the MinIO process on the same application server.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
BACKUP_S3_BUCKET="backups"
# All BACKUP_S3_* values are optional. Empty values keep the mandatory local
# pre-migration backup and only disable the independent off-site copy.

# ─── Email (optional — secondary alerts via Resend) ────────────────
RESEND_API_KEY=""
# Verified sender (a domain verified in your Resend account)
RESEND_FROM="Vigent <alerts@vigent.ir>"
# Ops inbox that receives critical platform alerts (e.g. ingestion failures).
# Leave empty to disable email alerts entirely.
ALERT_EMAIL=""

# ─── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical public origin used by metadata, sitemap and solution pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WIDGET_URL="http://localhost:3000"
# IANA timezone used for dashboard/admin reporting.
DASHBOARD_TZ="Asia/Tehran"
# Optional workspace id used to select public sitemap content.
PLATFORM_WORKSPACE_ID=""

# ─── Social links (footer/navbar — NEXT_PUBLIC_* is baked in at build) ──
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/vigent_ir"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/vigent_ir"

# ─── Payments: ZarinPay (rial) ─────────────────────────────────────
# Docs: https://github.com/miladrajabi2002/zarinpay-doc
# Get the access token from @miladrajabi2002 on Telegram.
ZARINPAY_ACCESS_TOKEN=""
# Store/gateway id (integer) — sent as store_id when creating a payment.
ZARINPAY_STORE_ID=""
# Override only for testing; defaults to https://zarinpay.me/api
# ZARINPAY_BASE_URL=""

# ─── Payments: NowPayments (crypto) ────────────────────────────────
# API key + IPN secret from https://account.nowpayments.io → Settings
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# Override only for sandbox/testing; defaults to https://api.nowpayments.io/v1
# NOWPAYMENTS_BASE_URL=""

# ─── Plan pricing (optional overrides; defaults in lib/billing/plans.ts) ──
# Rial prices (IRR). Displayed as toman (÷10) in the UI.
PLAN_PRICE_STARTER_IRR="8900000"
PLAN_PRICE_PRO_IRR="24900000"
PLAN_PRICE_BUSINESS_IRR="59000000"
# Crypto prices (USD, via NowPayments)
PLAN_PRICE_STARTER_USD="9"
PLAN_PRICE_PRO_USD="25"
PLAN_PRICE_BUSINESS_USD="59"
# Included wallet credit granted once per successful subscription payment (IRR)
PLAN_INCLUDED_CREDIT_STARTER_IRR="2000000"
PLAN_INCLUDED_CREDIT_PRO_IRR="6000000"
PLAN_INCLUDED_CREDIT_BUSINESS_IRR="15000000"

# Admin finance consolidation: explicit Iranian rials per one US dollar.
# Required for a non-misleading IRR profit after subtracting OpenRouter USD cost.
FINANCE_USD_TO_IRR=""

# ─── Plan limits (optional overrides) ──────────────────────────────
# Private safety ceilings (not sold as message packs)
PLAN_LIMIT_TRIAL_MSGS="100"
PLAN_LIMIT_STARTER_MSGS="25000"
PLAN_LIMIT_PRO_MSGS="150000"
PLAN_LIMIT_BUSINESS_MSGS="1000000"
# Per-reply discount by plan (basis points: 1000 = 10%)
PLAN_REPLY_DISCOUNT_STARTER_BPS="0"
PLAN_REPLY_DISCOUNT_PRO_BPS="1000"
PLAN_REPLY_DISCOUNT_BUSINESS_BPS="2000"
# Max active channel connections per workspace
PLAN_LIMIT_TRIAL_CHANNELS="1"
PLAN_LIMIT_STARTER_CHANNELS="2"
PLAN_LIMIT_PRO_CHANNELS="5"
PLAN_LIMIT_BUSINESS_CHANNELS="20"

# ─── Prisma Studio for the owner admin ─────────────────────────────
# Run `bash deploy/setup-db-studio.sh` once in production. Studio stays bound
# to 127.0.0.1:5555; nginx exposes this HTTPS URL only after validating the
# existing /admin session cookie. The script writes this value automatically.
PRISMA_STUDIO_URL=""
PRISMA_STUDIO_PORT="8443"
# Optional when the site's certificate is not in the standard Let's Encrypt path:
# PRISMA_STUDIO_TLS_CERT_PATH="/path/to/fullchain.pem"
# PRISMA_STUDIO_TLS_KEY_PATH="/path/to/privkey.pem"

# ─── Abuse protection ──────────────────────────────────────────────
# Hard daily cap on public web-widget messages per agent (all visitors).
WIDGET_DAILY_MESSAGE_CAP="1000"
# Daily per-workspace budget for Instagram automation uploads (bytes).
# Defaults to 536870912 (512 MiB) when omitted.
INSTAGRAM_UPLOAD_DAILY_BYTES="536870912"
# Aggregate cap across every workspace (defaults to 5 GiB/day).
INSTAGRAM_UPLOAD_GLOBAL_DAILY_BYTES="5368709120"
# Knowledge documents: per-workspace 200 MiB/day, aggregate 2 GiB/day.
KNOWLEDGE_UPLOAD_DAILY_BYTES="209715200"
KNOWLEDGE_UPLOAD_GLOBAL_DAILY_BYTES="2147483648"
TRUST_PROXY_HEADERS="0"
# Minimum delay between campaign sends. Keep at or above 50ms.
CAMPAIGN_SEND_INTERVAL_MS="180"

LONG_CHAT_THRESHOLD="10"

META_APP_ID=""
META_APP_SECRET=""

INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

META_APP_VERIFY_TOKEN=""

# Optional self-hosted WhatsApp QR bridge (run setup-whatsapp-bridge.sh).
WHATSAPP_BRIDGE_URL="http://127.0.0.1:3040"
WHATSAPP_BRIDGE_HOST="127.0.0.1"
WHATSAPP_BRIDGE_SECRET=""

# Development/test-only switches. Never enable private HTTP targets in production.
ALLOW_PRIVATE_HTTP_TARGETS="0"
PLATFORM_CONFIG_TEST_DB="0"
