generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── WORKSPACE (TENANT) ───────────────────────────────────────────
model Workspace {
  id                            String       @id @default(cuid())
  name                          String
  slug                          String       @unique
  plan                          Plan         @default(TRIAL)
  trialEndsAt                   DateTime?
  defaultModel                  String       @default("fast")
  defaultEmbedModel             String       @default("openai/text-embedding-3-small")
  defaultTtsVoice               String       @default("alloy")
  language                      String       @default("fa")
  // Prepaid successful-reply credit. Values are integer Iranian rials.
  aiCreditBalanceIRR            Int          @default(100000)
  aiCreditReservedIRR           Int          @default(0)
  // Email for the (upcoming) weekly business report — collected in settings.
  reportEmail                   String?
  // Operational vertical selected during onboarding. Channels stay independent
  // capabilities, so an Instagram seller is still COMMERCE rather than a
  // channel-specific business type.
  businessType                  BusinessType @default(CUSTOM)
  // Additive profile data (currently businessName + service labels). Keeping
  // this flexible lets onboarding evolve without another migration per answer.
  businessProfile               Json?
  onboardingStep                Int          @default(0) // 0-3, tracks contiguous agent/knowledge/channel checks
  onboardingStepUpdatedAt       DateTime     @default(now())
  onboardingCompleted           Boolean      @default(false)
  onboardingKnowledgeSkipped    Boolean      @default(false)
  onboardingChannelSkipped      Boolean      @default(false)
  dashboardChecklistDismissedAt DateTime?
  // Internal/test workspaces are intentionally omitted from admin commercial reports.
  excludeFromAdminReports       Boolean      @default(false)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  owner                    User?
  agents                   Agent[]
  contacts                 Contact[]
  conversations            Conversation[]
  subscriptions            Subscription[]
  usageLogs                UsageLog[]
  products                 Product[]
  productCategories        ProductCategory[]
  notifications            Notification[]
  blogPosts                BlogPost[]
  blogCategories           BlogCategory[]
  operatorChannels         OperatorChannel[]
  storeIntegrations        StoreIntegration[]
  handoffAlerts            HandoffAlert[]
  salesInsights            ConversationSalesInsight[]
  payments                 Payment[]
  adminCommercialSmsOutbox AdminCommercialSmsOutbox[]
  walletEntries            WalletLedger[]
  creditAlertStates        CreditAlertState[]
  chatLinks                ChatLink[]
  vigentoRuns              VigentoRun[]
  campaigns                Campaign[]
  services                 Service[]
  appointments             Appointment[]
  inboundEvents            InboundEvent[]
  conversationTurnLeases   ConversationTurnLease[]
  knowledgeApprovals       KnowledgeApproval[]

  @@index([slug])
  @@index([excludeFromAdminReports])
}

enum Plan {
  TRIAL
  STARTER
  PRO
  BUSINESS
}

enum BusinessType {
  COMMERCE
  FOOD
  APPOINTMENTS
  SERVICES
  EDUCATION
  SUPPORT
  SOCIAL
  CUSTOM
}

// ─── USER (phone-based, no email/password) ────────────────────────
model User {
  id           String       @id @default(cuid())
  workspaceId  String
  phone        String       @unique // e.g. +989121234567
  name         String?
  // Platform-wide authority is intentionally separate and has one owner.
  platformRole PlatformRole @default(USER)
  language     String       @default("fa")
  createdAt    DateTime     @default(now())

  workspace                  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeApprovalsVerified KnowledgeApproval[] @relation("KnowledgeApprovalVerifier")

  @@unique([workspaceId])
  @@index([phone])
  @@index([platformRole])
}

enum PlatformRole {
  USER
  ADMIN
}

// ─── OTP STORE (audit trail; live OTPs in Redis) ──────────────────
model OTPLog {
  id       String   @id @default(cuid())
  phone    String
  sentAt   DateTime @default(now())
  verified Boolean  @default(false)
  ip       String?

  @@index([phone])
  @@index([phone, sentAt])
  @@index([verified, sentAt])
}

// ─── AGENT ────────────────────────────────────────────────────────
model Agent {
  id                   String   @id @default(cuid())
  workspaceId          String
  name                 String
  description          String?
  systemPrompt         String   @db.Text
  model                String?
  temperature          Float    @default(0.55)
  maxTokens            Int      @default(600)
  language             String   @default("fa")
  voiceEnabled         Boolean  @default(false)
  ttsVoice             String   @default("alloy")
  avatar               String?
  welcomeMessage       String?
  fallbackMessage      String?
  handoffEnabled       Boolean  @default(false)
  handoffMessage       String?
  handoffKeywords      String[] @default([])
  active               Boolean  @default(true)
  // ─ 6-LAYER PROMPT ENGINE (F1) ─────────────────────────────────────────
  //   Structured prompt configuration that replaces the single-line systemPrompt
  //   with six composable layers: personality, tone, scope, fallback behavior,
  //   response format, and curated Q&A pairs. When promptConfig is set it takes
  //   precedence over systemPrompt; the legacy field is kept for backward-compat
  //   and as a free-form fallback.
  promptConfig         Json?
  //   Role template key used to seed promptConfig (e.g. 'sales_consult',
  //   'post_sale_support', 'pre_sales', 'follow_up', 'general_support').
  roleTemplate         String?
  // ─ Customer identification (F3): require name + phone at conversation start
  //   before the agent proceeds. Drives the collect-info flow at thread open.
  requireCustomerInfo  Boolean  @default(false)
  customerInfoPrompt   String?  @db.Text
  productAccessEnabled Boolean  @default(true)
  orderTrackingEnabled Boolean  @default(false)
  productAccessConfigured Boolean @default(false)
  orderTrackingConfigured Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace                   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels                    AgentChannel[]
  knowledgeBases              KnowledgeBase[]
  conversations               Conversation[]
  knowledgeChunks             KnowledgeChunk[]
  catalogItems                AgentCatalog[]
  versions                    AgentVersion[]
  handoffAlerts               HandoffAlert[]
  chatLink                    ChatLink?
  instagramAutomations        InstagramAutomation[]
  instagramFollowGates        InstagramFollowGate[]
  instagramAutomationSettings InstagramAutomationSettings?
  knowledgeApprovals          KnowledgeApproval[]

  @@index([workspaceId])
}

// ─── CHAT LINK (public standalone chat page, link-in-bio) ─────────────
//   A shareable slug (`/c/my-shop`) that opens a full-screen mobile-first chat
//   with the agent — no embed needed (e.g. Instagram bio "مشاوره آنلاین فوری").
//   Appearance/behavior settings live in the `settings` JSON, normalized by
//   lib/chat-link/config.ts (same pattern as the web widget).
model ChatLink {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String   @unique
  slug        String   @unique
  enabled     Boolean  @default(true)
  settings    Json?
  views       Int      @default(0) // page opens (lightweight funnel signal)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── AGENT VERSION (prompt/config snapshots for rollback) ─────────────
model AgentVersion {
  id           String   @id @default(cuid())
  agentId      String
  label        String
  systemPrompt String   @db.Text
  // Structured prompt snapshot. Nullable so versions created before the
  // layered prompt engine continue to restore through systemPrompt.
  promptConfig Json?
  roleTemplate String?
  model        String?
  temperature  Float    @default(0.55)
  maxTokens    Int      @default(600)
  note         String?
  createdAt    DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ─── CHANNEL CONNECTIONS ──────────────────────────────────────────
model AgentChannel {
  id              String      @id @default(cuid())
  agentId         String
  type            ChannelType
  config          Json // encrypted token/config
  active          Boolean     @default(true)
  webhookUrl      String?
  lastInboundAt   DateTime? // last time an inbound webhook message arrived (health signal)
  healthAlertedAt DateTime? // last time a "channel silent" alert was sent (dedup)
  createdAt       DateTime    @default(now())

  agent                  Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  inboundEvents          InboundEvent[]
  conversationTurnLeases ConversationTurnLease[]

  @@unique([agentId, type])
  @@index([agentId])
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
  INSTAGRAM
  RUBIKA
  BALE
  WEB_WIDGET
  CHAT_LINK
  API
}

// Durable inbox ledger for the at-least-once webhook/queue boundary. A row is
// never deleted during normal processing: COMPLETED is the durable dedupe
// marker, while an expired PROCESSING lease can be atomically reclaimed after
// a worker crash. leaseToken is a fencing token; stale workers cannot commit a
// result after a newer owner has reclaimed the event.
model InboundEvent {
  id                  String            @id @default(cuid())
  workspaceId         String
  channelId           String
  externalEventId     String
  conversationKey     String
  eventType           String
  payloadHash         String
  payload             Json?
  state               InboundEventState @default(RECEIVED)
  leaseOwner          String?
  leaseToken          Int               @default(0)
  leaseExpiresAt      DateTime?
  attempts            Int               @default(0)
  conversationId      String?
  inboundMessageId    String?
  resultMessageId     String?
  result              Json?
  lastError           String?           @db.Text
  processingStartedAt DateTime?
  effectsCommittedAt  DateTime?
  // Channel APIs generally lack an idempotency key. This marker is written
  // before the first provider send (at-most-once policy): a crash retry will
  // not duplicate a reply whose delivery outcome is ambiguous.
  deliveryStartedAt   DateTime?
  deliveryCompletedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel        AgentChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inboundMessage Message?     @relation("InboundEventInboundMessage")
  resultMessage  Message?     @relation("InboundEventResultMessage")

  @@unique([workspaceId, channelId, externalEventId])
  @@index([state, leaseExpiresAt])
  @@index([workspaceId, createdAt])
  @@index([channelId, conversationKey])
}

enum InboundEventState {
  RECEIVED
  PROCESSING
  EFFECTS_COMMITTED
  COMPLETED
  DELIVERY_UNCERTAIN
  FAILED
}

// Database-backed per-thread lease. Unlike the old Redis mutex, waiters never
// proceed unlocked on timeout. fencingToken increases on every acquisition so
// an expired owner cannot release or finalize work owned by its successor.
model ConversationTurnLease {
  id              String    @id @default(cuid())
  workspaceId     String
  channelId       String
  conversationKey String
  leaseOwner      String?
  fencingToken    Int       @default(0)
  leaseExpiresAt  DateTime?
  eventId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   AgentChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channelId, conversationKey])
  @@index([leaseExpiresAt])
  @@index([eventId])
}

// ─── PRODUCT CATALOG ──────────────────────────────────────────────
model ProductCategory {
  id                  String   @id @default(cuid())
  workspaceId         String
  sourceIntegrationId String?
  externalId          String?
  name                String
  slug                String
  parentId            String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceIntegration StoreIntegration? @relation(fields: [sourceIntegrationId], references: [id], onDelete: SetNull)
  parent            ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          ProductCategory[] @relation("CategoryTree")
  products          Product[]

  @@unique([workspaceId, slug])
  @@unique([sourceIntegrationId, externalId])
  @@index([workspaceId])
  @@index([sourceIntegrationId])
}

model Product {
  id                  String    @id @default(cuid())
  workspaceId         String
  sourceIntegrationId String?
  externalId          String?
  sourceUpdatedAt     DateTime?
  sourceHash          String?
  categoryId          String?
  name                String
  description         String?   @db.Text
  price               Float?
  comparePrice        Float? // original price (for showing discount)
  sku                 String?
  stock               Int? // null = unlimited
  images              String[] // Supabase Storage URLs
  attributes          Json? // {"color": "blue", "size": "XL"}
  tags                String[]
  externalUrl         String? // canonical product URL on the source store (WooCommerce permalink, etc.) — used for the "View product" button in Instagram product cards
  active              Boolean   @default(true)
  embeddingUpdatedAt  DateTime? // track when last embedded into vector store
  queryCount          Int       @default(0) // how many times AI retrieved this product
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceIntegration StoreIntegration? @relation(fields: [sourceIntegrationId], references: [id], onDelete: SetNull)
  category          ProductCategory?  @relation(fields: [categoryId], references: [id])
  catalogItems      AgentCatalog[]

  // External source identity is authoritative. SKU remains indexed for search
  // and one-time adoption of catalog rows created before source IDs existed.
  // The migration also adds a partial unique SKU index for manual rows only.
  @@unique([sourceIntegrationId, externalId])
  // Name is the secondary dedup key (case-insensitive matching happens at the
  // app layer). A plain index keeps the case-sensitive name lookups fast.
  @@index([workspaceId, name])
  @@index([workspaceId, sku])
  @@index([workspaceId])
  @@index([sourceIntegrationId])
  @@index([categoryId])
}

// Agent ↔ Product many-to-many (which products does each agent know about)
model AgentCatalog {
  id        String @id @default(cuid())
  agentId   String
  productId String

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([agentId, productId])
  @@index([agentId])
}

// ─── KNOWLEDGE BASE ───────────────────────────────────────────────
model KnowledgeBase {
  id                   String    @id @default(cuid())
  agentId              String
  workspaceId          String
  name                 String
  type                 KBType
  sourceUrl            String?
  fileKey              String?
  fileName             String?
  fileSize             Int?
  status               KBStatus  @default(PENDING)
  chunkCount           Int       @default(0)
  errorMsg             String?
  // ─ F4: freshness tracking. For URL sources, lastIngestedAt records when the
  //   content was last re-fetched and re-embedded. refreshIntervalHours controls
  //   the automatic re-crawl cadence (0 = manual only).
  lastIngestedAt       DateTime?
  refreshIntervalHours Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  agent    Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]
  approval KnowledgeApproval?

  @@index([agentId])
  @@index([workspaceId])
}

enum LearningSource {
  AI_UNANSWERED
  OPERATOR_REPLY
}

/**
 * Human approval ledger for Q&A promoted from a conversation into reusable
 * knowledge. Permanent reference fields retain provenance even if the source
 * conversation or approving user is later removed.
 */
model KnowledgeApproval {
  id                   String         @id @default(cuid())
  workspaceId          String
  agentId              String
  knowledgeBaseId      String         @unique
  sourceMessageId      String?        @unique
  sourceMessageRef     String         @unique
  sourceConversationId String
  source               LearningSource
  question             String         @db.Text
  answer               String         @db.Text
  contentHash          String
  verifiedByUserId     String?
  verifiedByUserRef    String
  verifiedAt           DateTime       @default(now())
  validFrom            DateTime       @default(now())
  validUntil           DateTime?
  knowledgeVersion     Int            @default(1)
  policyVersion        String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sourceMessage Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  verifiedBy    User?         @relation("KnowledgeApprovalVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, verifiedAt])
  @@index([agentId, validUntil])
  @@index([verifiedByUserRef])
}

enum KBType {
  PDF
  CSV
  URL
  TEXT
  FAQ
  PRODUCT_CATALOG
}

enum KBStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

// ─── KNOWLEDGE CHUNKS (with vector embeddings) ────────────────────
model KnowledgeChunk {
  id          String                       @id @default(cuid())
  kbId        String
  agentId     String
  workspaceId String
  content     String                       @db.Text
  metadata    Json? // {source, page, productId, sku, price}
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())

  kb    KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  agent Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([workspaceId])
}

// ─── CONTACT (CRM) ────────────────────────────────────────────────
model Contact {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String?
  phone              String?
  telegramId         String?
  whatsappId         String?
  instagramId        String?
  rubikaId           String?
  baleId             String?
  tags               String[]
  stage              String    @default("lead")
  notes              String?   @db.Text
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // ─ Denormalized "last activity" timestamp, bumped on every inbound/AI/
  //   operator message across this contact's conversations. Drives the
  //   "آخرین فعالیت" column on the contacts list (previously we showed
  //   `updatedAt`, which only changes when the contact row itself is mutated —
  //   so it reported stale times even when messages were flowing).
  lastActivityAt     DateTime?
  // ─ Per-channel profile data captured from inbound webhooks + profile fetches.
  //   Stored best-effort (backfilled when empty); null when the platform doesn't
  //   expose it (e.g. WhatsApp customer avatars aren't available via the API).
  telegramUsername   String?
  telegramAvatarUrl  String?
  baleUsername       String?
  baleAvatarUrl      String?
  rubikaUsername     String?
  rubikaAvatarUrl    String?
  whatsappName       String?
  whatsappAvatarUrl  String?
  instagramUsername  String?
  instagramAvatarUrl String?
  // Explicit consent gate for non-transactional campaign messages. New and
  // existing contacts are opted out until consent is recorded by the owner or
  // a channel-native flow.
  marketingOptIn     Boolean   @default(false)
  marketingOptInAt   DateTime?
  marketingOptOutAt  DateTime?

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  appointments       Appointment[]

  @@index([workspaceId])
  @@index([workspaceId, phone])
  @@index([telegramId])
  @@index([phone])
  @@index([lastActivityAt])
  // Contact lists search and sort by name; keeps prefix searches and
  // name-ordered listings index-backed.
  @@index([name])
}

// ─── CONVERSATION ─────────────────────────────────────────────────
model Conversation {
  id                String      @id @default(cuid())
  workspaceId       String
  agentId           String
  contactId         String?
  channel           ChannelType
  externalId        String?
  status            ConvStatus  @default(OPEN)
  handedOff         Boolean     @default(false)
  rating            Int?
  summary           String?     @db.Text
  messageCount      Int         @default(0)
  lastMessageAt     DateTime?
  // ─ F3: customer identification state. 'pending' until the contact has given
  //   their name+phone; 'collected' once captured. 'skipped' for channels where
  //   the platform identity is already trusted (messenger bots).
  customerInfoState String      @default("pending")
  identifiedAt      DateTime?
  // ─ Channel-automation flags. Currently used by the Instagram automation
  //   engine to mark a conversation as "AI paused" (e.g. when a STOP_AI scenario
  //   matches, or when an operator wants only scenarios to reply). Shape:
  //   { aiPaused?: boolean, pausedAt?: string, pausedBy?: string }
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent         Agent                     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact       Contact?                  @relation(fields: [contactId], references: [id])
  messages      Message[]
  handoffAlerts HandoffAlert[]
  salesInsight  ConversationSalesInsight?

  @@unique([agentId, channel, externalId])
  @@index([workspaceId])
  @@index([workspaceId, updatedAt])
  @@index([agentId])
  @@index([contactId])
  @@index([externalId])
  // Inbox lists filter by workspace + status; the pair avoids a filter+sort
  // over the whole workspace partition as conversation volume grows.
  @@index([workspaceId, status])
}

enum ConvStatus {
  OPEN
  RESOLVED
  HANDED_OFF
}

// ─── MESSAGE ──────────────────────────────────────────────────────
// Latest explainable, behaviour-based sales reading for a conversation.
// This is deliberately not a psychological/personality profile: it records
// observable buying signals, objections, urgency and recommended next steps.
model ConversationSalesInsight {
  id                   String              @id @default(cuid())
  workspaceId          String
  conversationId       String              @unique
  leadType             SalesLeadType       @default(UNCLEAR)
  stage                SalesIntentStage    @default(UNKNOWN)
  buyerReadiness       SalesBuyerReadiness @default(COLD)
  buyerProbability     Int                 @default(0)
  sentiment            SalesSentiment      @default(NEUTRAL)
  urgency              SalesUrgency        @default(LOW)
  confidence           Float               @default(0)
  objections           String[]            @default([])
  riskFlags            String[]            @default([])
  signalCodes          String[]            @default([])
  // Bounded evidence snippets only (never a transcript dump).
  evidence             Json?
  recommendedAction    String?             @db.Text
  explanation          String?             @db.Text
  handoffRecommended   Boolean             @default(false)
  handoffReasonCodes   String[]            @default([])
  modelVersion         String              @default("sales-heuristic-v1")
  analyzedMessageCount Int                 @default(0)
  analyzedAt           DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, buyerProbability])
  @@index([workspaceId, stage])
  @@index([workspaceId, handoffRecommended])
  @@index([workspaceId, updatedAt])
}

enum SalesLeadType {
  UNCLEAR
  INFORMATION_SEEKER
  BUYER
  EXISTING_CUSTOMER
  SUPPORT_SEEKER
}

enum SalesIntentStage {
  UNKNOWN
  DISCOVERY
  INFORMATION_GATHERING
  CONSIDERATION
  NEGOTIATION
  PURCHASE_INTENT
  POST_PURCHASE
}

enum SalesBuyerReadiness {
  COLD
  EXPLORING
  WARM
  HOT
  CUSTOMER
}

enum SalesSentiment {
  NEGATIVE
  NEUTRAL
  POSITIVE
  MIXED
  DISTRESSED
}

enum SalesUrgency {
  LOW
  MEDIUM
  HIGH
}

model Message {
  id                      String      @id @default(cuid())
  conversationId          String
  role                    MessageRole
  content                 String      @db.Text
  contentType             ContentType @default(TEXT)
  audioUrl                String?
  metadata                Json?
  rating                  Int?
  unanswered              Boolean     @default(false)
  createdAt               DateTime    @default(now())
  // ─ Reply-to (quote) support. When a visitor replies to a specific message
  //   (web widget / chat link), this points at the quoted message. The dashboard
  //   thread renders a small quote block above the bubble when set.
  parentId                String?
  // Exactly-once anchors for durable inbound retries. PostgreSQL permits
  // multiple NULLs in unique indexes, so ordinary widget/API messages are
  // unaffected while one ledger event can create at most one USER/result row.
  inboundEventId          String?     @unique
  resultForInboundEventId String?     @unique

  conversation          Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent                Message?           @relation("MessageReplies", fields: [parentId], references: [id])
  replies               Message[]          @relation("MessageReplies")
  inboundEvent          InboundEvent?      @relation("InboundEventInboundMessage", fields: [inboundEventId], references: [id], onDelete: SetNull)
  resultForInboundEvent InboundEvent?      @relation("InboundEventResultMessage", fields: [resultForInboundEventId], references: [id], onDelete: SetNull)
  learningApproval      KnowledgeApproval?

  @@index([conversationId])
  @@index([parentId])
  // Threads are rendered in createdAt order — the composite lets Postgres
  // walk the index instead of sorting each conversation's messages.
  @@index([conversationId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ContentType {
  TEXT
  AUDIO
  IMAGE
}

// ─── USAGE LOG ────────────────────────────────────────────────────
model UsageLog {
  id                String      @id @default(cuid())
  workspaceId       String
  agentId           String?
  date              DateTime    @default(now())
  conversationId    String?
  promptTokens      Int         @default(0)
  completionTokens  Int         @default(0)
  reasoningTokens   Int         @default(0)
  cachedTokens      Int         @default(0)
  model             String?
  providerRequestId String?
  cost              Float?
  chargedIRR        Int         @default(0)
  status            UsageStatus @default(CAPTURED)
  idempotencyKey    String?     @unique
  type              LogType

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  walletEntries WalletLedger[]

  @@index([workspaceId, date])
}

enum UsageStatus {
  RESERVED
  CAPTURED
  RELEASED
}

enum LogType {
  CHAT
  EMBEDDING
  TTS
  STT
  SUMMARY
  LEARNING
  VIGENTO_DRAFT
  VIGENTO_ASSISTANT
}

// ─── SUBSCRIPTION ─────────────────────────────────────────────────
model Subscription {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  plan             Plan
  status           SubStatus @default(ACTIVE)
  monthlyPrice     Float
  currency         String    @default("IRR") // Iranian Rial
  currentPeriodEnd DateTime
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

// ─── PAYMENT (gateway transactions: ZarinPay rial / NowPayments crypto) ──
model Payment {
  id              String         @id @default(cuid())
  workspaceId     String
  gateway         PaymentGateway
  plan            Plan?
  kind            PaymentKind    @default(SUBSCRIPTION)
  amount          Float // in `currency` units (IRR for ZarinPay, USD for NowPayments)
  currency        String // 'IRR' | 'USD'
  status          PaymentStatus  @default(PENDING)
  // Gateway handle used to verify: ZarinPay `authority`, NowPayments order/invoice id.
  authority       String?        @unique
  // Gateway-side transaction/payment id captured on verification.
  externalId      String?
  // Raw verify/IPN payload kept for dispute debugging.
  callbackPayload Json?
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  walletEntry        WalletLedger?
  adminCommercialSms AdminCommercialSmsOutbox?

  @@index([workspaceId, createdAt])
  @@index([status])
}

model AdminCommercialSmsOutbox {
  id            String    @id @default(cuid())
  paymentId     String    @unique
  workspaceId   String
  kind          String
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sentAt, nextAttemptAt])
  @@index([workspaceId, createdAt])
}

enum PaymentKind {
  SUBSCRIPTION
  AI_CREDIT
}

enum PaymentGateway {
  ZARINPAY
  NOWPAYMENTS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model WalletLedger {
  id              String          @id @default(cuid())
  workspaceId     String
  usageLogId      String?
  paymentId       String?         @unique
  // Idempotency key for non-payment wallet grants (subscription gift, etc.).
  grantKey        String?         @unique
  type            WalletEntryType
  // Signed integer IRR: top-ups/refunds are positive; AI charges are negative.
  amountIRR       Int
  balanceAfterIRR Int
  note            String?
  createdAt       DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageLog  UsageLog? @relation(fields: [usageLogId], references: [id], onDelete: SetNull)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([usageLogId])
}

enum WalletEntryType {
  CREDIT_TOPUP
  PLAN_CREDIT_GRANT
  AI_CHARGE
  AI_REFUND
  ADMIN_ADJUSTMENT
}

// Per-model low-credit latch. A high balance re-arms it; entering the range
// below 20 estimated replies atomically disarms it and emits one alert.
model CreditAlertState {
  id             String    @id @default(cuid())
  workspaceId    String
  modelAlias     String
  armed          Boolean   @default(true)
  lastAlertedAt  DateTime?
  thresholdIRR   Int
  lastBalanceIRR Int
  updatedAt      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, modelAlias])
  @@index([workspaceId, updatedAt])
}

// Singleton runtime policy for the platform-owned AI account. Secrets remain
// in environment variables; this table stores only safe aliases and budgets.

// ─── MARKETING SHOWCASE ───────────────────────────────────────────
// Customer stories shown on the public homepage. Fully managed from the
// admin panel (add / edit / reorder / hide) — no deploy needed. Platform-level
// content: intentionally NOT scoped to a workspace.
model ShowcaseEntry {
  id          String   @id @default(cuid())
  // Business display name, e.g. «فروشگاه مانتو آیدا»
  name        String
  // Instagram username without @ (rendered as the card link when set)
  handle      String?
  // Explicit link (customer site/page); falls back to instagram.com/<handle>
  url         String?
  // Uploaded square image (logo or page screenshot) — /api/uploads/showcase/
  imageUrl    String?
  // Channels this customer runs on: INSTAGRAM / TELEGRAM / BALE / RUBIKA / WEB
  channels    String[] @default([])
  // One-line customer quote or outcome
  quote       String?  @db.Text
  // Highlighted metric, e.g. value «۹۸٪» label «پاسخ خودکار»
  metricValue String?
  metricLabel String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model PlatformAiSettings {
  id                String   @id @default("primary")
  defaultModel      String   @default("fast")
  enabledModels     String[] @default(["fast", "standard", "balanced", "premium"])
  trialModel        String   @default("fast")
  vigentoModel      String   @default("balanced")
  providerModels    Json     @default("{}")
  monthlyBudgetUSD  Float?
  sttModel          String   @default("openai/whisper-large-v3-turbo")
  ttsModel          String   @default("openai/gpt-4o-mini-tts-2025-12-15")
  providerSort      String   @default("price")
  zeroDataRetention Boolean  @default(true)
  replyPricesIRR    Json     @default("{}")
  trialCreditIRR    Int      @default(100000)
  planConfig        Json     @default("{}")
  financeUsdToIRR   Int?
  updatedAt         DateTime @updatedAt
}

// Durable audit trail for every confirmed operation performed from the
// owner-only Vigento admin console. Prompts are never stored here; only the
// allow-listed action receipt and its exact target are persisted.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminPhone String
  action     String
  targetType String
  targetId   String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// Durable owner-only conversation history for the admin Vigento copilot.
// Resetting the chat explicitly removes these rows; regular navigation and
// deployments never discard the conversation context.
model AdminVigentoMessage {
  id         String   @id @default(cuid())
  adminPhone String
  role       String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([adminPhone, createdAt])
}

// Privacy-safe operational telemetry for Vigento, the agent-building
// assistant. Raw descriptions and generated drafts deliberately do not live in
// this table; only outcome/model/duration and explicit user feedback do.
model VigentoRun {
  id          String           @id @default(cuid())
  workspaceId String
  status      VigentoRunStatus
  modelAlias  String?
  durationMs  Int
  applied     Boolean          @default(false)
  appliedAt   DateTime?
  helpful     Boolean?
  failureCode String?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

enum VigentoRunStatus {
  SUCCEEDED
  FAILED
}

// Campaigns are frozen, auditable batches. Creating a DRAFT never sends;
// explicit confirmation transitions it to QUEUED and a worker processes each
// unique recipient while re-checking consent and channel eligibility.
model Campaign {
  id                     String         @id @default(cuid())
  workspaceId            String
  name                   String
  message                String         @db.Text
  status                 CampaignStatus @default(DRAFT)
  audienceSnapshot       Json
  expectedRecipientCount Int
  eligibleCount          Int            @default(0)
  excludedCount          Int            @default(0)
  sentCount              Int            @default(0)
  failedCount            Int            @default(0)
  skippedCount           Int            @default(0)
  confirmedAt            DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model CampaignRecipient {
  id             String                  @id @default(cuid())
  campaignId     String
  contactId      String
  status         CampaignRecipientStatus @default(PENDING)
  channel        ChannelType?
  conversationId String?
  errorCode      String?
  attemptCount   Int                     @default(0)
  sentAt         DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
}

enum CampaignRecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

// ─── NOTIFICATION (in-app bell; may also fan out to email/SMS) ────────
model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  type        NotificationType
  title       String
  body        String?          @db.Text
  link        String? // in-app deep link, e.g. /conversations/<id>
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, read, createdAt])
}

enum NotificationType {
  NEW_MESSAGE
  HANDOFF
  APPOINTMENT
  CHANNEL_DOWN
  LEARNING
  SYSTEM
}

// ─── ERROR LOG (surfaced in the /admin monitoring dashboard) ──────────
// Captured application errors so the operator can watch production health
// without tailing PM2 logs. Written fire-and-forget via captureError().
model ErrorLog {
  id          String   @id @default(cuid())
  level       String   @default("error") // error | warn
  source      String? // e.g. "chat-engine", "webhook:telegram"
  message     String   @db.Text
  stack       String?  @db.Text
  workspaceId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── BLOG (SEO content marketing) ────────────────────────────────────
// Self-hosted blog under each workspace so the tenant can publish AI /
// product-related content to drive organic search traffic. Posts are
// Markdown-rendered server-side with full SEO metadata + JSON-LD.
model BlogCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     BlogPost[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model BlogPost {
  id             String     @id @default(cuid())
  workspaceId    String
  categoryId     String?
  title          String
  slug           String
  excerpt        String?    @db.Text
  content        String     @db.Text // Markdown
  coverImage     String?
  status         BlogStatus @default(DRAFT)
  // SEO overrides (optional; defaults derived from title/excerpt/content)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]   @default([])
  canonicalUrl   String?
  ogImage        String?
  readingMinutes Int        @default(1) // auto-computed on save
  views          Int        @default(0)
  featured       Boolean    @default(false)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  BlogCategory? @relation(fields: [categoryId], references: [id])

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, publishedAt])
  @@index([workspaceId, featured])
  @@index([categoryId])
  // Admin "most viewed posts" orders by views across all posts.
  @@index([views])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// ─── OPERATOR CHANNEL (F3) ───────────────────────────────────────────
//   A workspace's "operator Telegram bot": when an agent hands a conversation
//   off to a human, the alert + conversation summary is pushed to this bot so
//   the operator can read the context and reply. The operator replies inside
//   the same conversations panel in the dashboard (and optionally from their
//   own Telegram if the bot is configured with a chat id).
model OperatorChannel {
  id             String   @id @default(cuid())
  workspaceId    String   @unique // one operator bot per workspace for now
  botToken       String // encrypted at rest by the app layer (lib/crypto)
  operatorChatId String? // Telegram chat id where handoff alerts are sent
  botUsername    String? // @username of the bot, shown to operators for /start
  active         Boolean  @default(true)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── HANDOFF ALERT (F3) ──────────────────────────────────────────────
//   A single handoff event: created when an agent escalates a conversation to a
//   human. Carries the snapshot of customer identity + conversation summary so
//   the operator has everything in one place without re-reading the whole thread.
model HandoffAlert {
  id                String      @id @default(cuid())
  workspaceId       String
  conversationId    String
  agentId           String
  // Snapshot at handoff time — the contact's name/phone (if collected) and a
  // one-line summary so the operator can triage without opening the thread.
  contactName       String?
  contactPhone      String?
  channel           ChannelType
  reason            String?     @db.Text // keyword match, repeated fallbacks, manual
  summary           String?     @db.Text
  // 'open' = awaiting operator; 'claimed' = operator opened it; 'resolved' = done
  state             String      @default("open")
  claimedBy         String? // operator user id (future)
  // Telegram message id of the alert we sent to the operator bot, so a later
  // operator reply in Telegram can be correlated back to this conversation.
  externalMessageId String?
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@index([conversationId])
  @@index([agentId])
}

// ─── STORE INTEGRATION (F2) ──────────────────────────────────────────
//   Connection to an external e-commerce store (WooCommerce, Shopify-like, or a
//   custom URL to crawl). Products and orders are pulled (or pushed via webhook)
//   into the workspace's catalog and a dedicated orders table so the agent can
//   answer "where is my order?" with live data.
model StoreIntegration {
  id                  String    @id @default(cuid())
  workspaceId         String
  type                StoreType
  // For WooCommerce: store base URL (e.g. https://shop.example.com)
  storeUrl            String
  // API credentials (consumer key/secret for Woo REST, or a webhook signing secret)
  // encrypted at rest by the app layer.
  credentials         Json
  // HMAC secret used to verify inbound webhook pushes from the store plugin.
  webhookSecret       String?
  // Polling cadence for the fallback sync (minutes). 0 = webhook only.
  pollIntervalMinutes Int       @default(30)
  lastSyncAt          DateTime?
  lastSyncStatus      String? // 'ok' | 'error'
  lastSyncError       String?
  connectedAt         DateTime?
  lastWebhookAt       DateTime?
  pluginVersion       String?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders            StoreOrder[]
  syncLogs          StoreSyncLog[]
  products          Product[]
  categories        ProductCategory[]
  webhookDeliveries StoreWebhookDelivery[]

  @@index([workspaceId])
  @@index([webhookSecret])
}

enum StoreType {
  WOOCOMMERCE
  CUSTOM_URL
  SHOPIFY
}

// ─── STORE ORDER (F2) ────────────────────────────────────────────────
//   Lightweight mirror of an external order so the agent can answer order-status
//   questions. Updated by webhook push (plugin) and periodic poll (fallback).
model StoreOrder {
  id              String    @id @default(cuid())
  integrationId   String
  workspaceId     String
  // The order number/id from the external store (e.g. Woo order #1234).
  externalOrderId String
  // Customer reference (matched to a Contact when possible by phone/email).
  contactId       String?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  status          String // 'pending' | 'processing' | 'on-hold' | 'completed' | 'cancelled' | 'refunded' | 'failed'
  total           Float
  currency        String    @default("IRR")
  itemCount       Int       @default(0)
  // Short line-item summary for the agent (e.g. "2× T-shirt, 1× Cap")
  itemsSummary    String?   @db.Text
  paymentMethod   String?
  shippingMethod  String?
  trackingCode    String?
  // ─── Shipping / delivery info (v4.2.4+) ────────────────────────────
  // Populated from the WooCommerce plugin's shipping_info object, which
  // aggregates meta keys from Iranian shipment plugins (PWS, Postex,
  // WooCommerce Shipment Tracking, custom theme fields).
  courierName     String?   // e.g. «پست پیشتاز», «تیپاکس»
  shippingDate    String?   // Jalali or Gregorian, passed through as-is
  trackingLink    String?   // e.g. https://tracking.post.ir/?id=1234567890123
  shippingNote    String?   @db.Text // extra description from the store
  // ISO date strings from the store
  orderDate       DateTime?
  updatedAt       DateTime?
  createdAt       DateTime  @default(now())

  integration StoreIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalOrderId])
  @@index([workspaceId])
  @@index([contactId])
  @@index([externalOrderId])
}

// ─── STORE SYNC LOG (F2) ─────────────────────────────────────────────
//   Audit trail of each sync attempt (products / orders / push / poll) so the
//   workspace owner can see what was imported and when, and debug failures.
model StoreSyncLog {
  id            String   @id @default(cuid())
  integrationId String
  workspaceId   String
  direction     String // 'push' (webhook from store) | 'poll' (we fetched)
  entity        String // 'products' | 'orders' | 'product_update' | 'order_update'
  outcome       String // 'ok' | 'error'
  count         Int      @default(0)
  message       String?  @db.Text
  createdAt     DateTime @default(now())

  integration StoreIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([workspaceId])
  @@index([outcome, createdAt])
}

// Platform-owner inbox for info@vigent.ir. Inbound messages are idempotent by
// provider id; replies stay attached to the original message to keep the admin
// workflow deliberately small and auditable.
model AdminMailboxMessage {
  id                   String    @id @default(cuid())
  providerEmailId      String    @unique
  webhookEventId       String?   @unique
  messageId            String?
  from                 String
  to                   String[]
  cc                   String[]  @default([])
  replyTo              String[]  @default([])
  subject              String
  text                 String?   @db.Text
  html                 String?   @db.Text
  preview              String    @db.Text
  attachments          Json?
  receivedAt           DateTime
  readAt               DateTime?
  forwardedAt          DateTime?
  repliedAt            DateTime?
  replyText            String?   @db.Text
  replyProviderEmailId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([readAt, receivedAt])
  @@index([receivedAt])
}

model StoreWebhookDelivery {
  id            String    @id @default(cuid())
  integrationId String
  deliveryId    String
  payloadHash   String
  eventCount    Int       @default(0)
  status        String    @default("pending")
  error         String?   @db.Text
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  integration StoreIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, deliveryId])
  @@index([integrationId, status])
  @@index([receivedAt])
}

// ─── INSTAGRAM AUTOMATION (DM / Comment / Story) ─────────────────────
//   Per-agent automation scenarios for a connected Instagram channel.
//   Replaces the "reply-only" model with keyword triggers, follow-gating,
//   comment→DM funnels, and smart (AI) replies to story mentions/replies.
//
//   `trigger` JSON shape:
//     { keywords: string[], matchMode: 'EXACT'|'CONTAINS'|'STARTS_WITH',
//       storyScope: 'ALL'|'KEYWORD', postIds?: string[] }
//
//   `action` JSON shape:
//     { replyMode: 'STATIC'|'AI',
//       replyText?: string,            // STATIC reply (or AI fallback context)
//       dmOnComment?: boolean,         // COMMENT type: also send a DM
//       followGate?: boolean,          // require follow before sending content
//       gateMode?: 'SOFT'|'STORY_MENTION',
//       gatePrompt?: string,           // "follow us and reply 'done'"
//       gateConfirmKeyword?: string,   // e.g. "done" / "فالو کردم"
//       gateQuickReply?: string,       // button label e.g. "فالو کردم"
//       contentText?: string,          // sent after gate fulfilled
//       aiAgentEnabled?: boolean }     // route through the agent's AI engine
model InstagramAutomation {
  id        String                  @id @default(cuid())
  agentId   String
  channelId String // the INSTAGRAM AgentChannel this scenario belongs to
  type      InstagramAutomationType
  name      String
  active    Boolean                 @default(true)
  priority  Int                     @default(0) // higher = evaluated first when multiple match
  trigger   Json
  action    Json
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  agent       Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  followGates InstagramFollowGate[]

  @@index([agentId, type, active])
  @@index([channelId])
  @@index([agentId, active, priority])
}

enum InstagramAutomationType {
  DIRECT_MESSAGE
  COMMENT
  STORY
}

// ─── INSTAGRAM FOLLOW-GATE STATE ─────────────────────────────────────
//   Tracks a pending follow-gate for a user who triggered a gated automation.
//   Created when the user comments/DMs the keyword; fulfilled when they reply
//   the confirm keyword (SOFT gate) or mention the account in a story
//   (STORY_MENTION gate, verified via the story_mention webhook).
model InstagramFollowGate {
  id           String    @id @default(cuid())
  automationId String
  agentId      String
  contactId    String?
  igSenderId   String // IG-scoped id of the user who triggered the gate
  chatId       String // messaging chat id to address the DM reply
  status       String    @default("PENDING") // PENDING | FULFILLED | EXPIRED
  payload      Json? // snapshot (keyword, postId, etc.) for debugging
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  fulfilledAt  DateTime?

  automation InstagramAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  agent      Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([automationId, igSenderId])
  @@index([status])
  @@index([agentId, status])
}

// ─── INSTAGRAM AUTOMATION SETTINGS (channel-level policy) ───────────
//   Per-(agent × Instagram channel) automation policy + master toggles.
//   Mirrors Vardast's "channel reply policy" selector:
//
//     replyPolicy:
//       ALL_AGENT              — the AI agent replies to every inbound message
//                                (scenarios still run first; AI is the fallback)
//       AGENT_EXCEPT_SCENARIOS — the AI agent replies UNLESS a scenario matched
//                                (default; backwards-compatible with v1)
//       AUTOMATION_ONLY        — the AI agent is OFF; only scenarios reply. When
//                                no scenario matches, the inbound is recorded
//                                silently with no outbound reply.
//
//   `stopWords` are keywords that — when present in an inbound DM — pause the AI
//   for that conversation (sets conversation.metadata.aiPaused = true). Typical
//   use: "stop", "توقف", "تماس با اپراتور". The operator can resume AI from the
//   inbox (which clears the flag).
//
//   `welcomeMessage` is sent once on the user's first DM to the account.
//
//   `followUp*` configure the "no reply after N minutes" follow-up nudges that
//   Vardast sends from the operator's account.
model InstagramAutomationSettings {
  id                          String   @id @default(cuid())
  agentId                     String   @unique
  channelId                   String   @unique
  replyPolicy                 String   @default("AGENT_EXCEPT_SCENARIOS") // ALL_AGENT | AGENT_EXCEPT_SCENARIOS | AUTOMATION_ONLY
  dmReplyPolicy               String   @default("AGENT_EXCEPT_SCENARIOS")
  storyReplyPolicy            String   @default("AGENT_EXCEPT_SCENARIOS")
  commentReplyPolicy          String   @default("AGENT_EXCEPT_SCENARIOS")
  storyReactionReplyEnabled   Boolean  @default(false)
  storyReactionReplyText      String?  @db.Text
  commentEmojiReplyEnabled    Boolean  @default(false)
  commentEmojiReplyText       String?  @db.Text
  likeDmAfterReply            Boolean  @default(false)
  likeStoryReplyAfterReply    Boolean  @default(false)
  likeStoryReactionAfterReply Boolean  @default(false)
  likeCommentAfterReply       Boolean  @default(false)
  stopWords                   String[] @default([]) // keywords that pause AI for this conversation
  welcomeMessage              String?  @db.Text // sent on the user's first DM
  followUpEnabled             Boolean  @default(false)
  followUpDelayMin            Int      @default(60) // minutes after no reply
  followUpMessage             String?  @db.Text
  aiEnabled                   Boolean  @default(true) // master toggle for AI replies
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ─── BOOKING SERVICES & AVAILABILITY ────────────────────────────────
// Services own their calendar policy. All timestamps are persisted in UTC;
// `timezone` controls how weekly rules and date exceptions are interpreted.
model Service {
  id                  String   @id @default(cuid())
  workspaceId         String
  slug                String
  name                String
  description         String?  @db.Text
  durationMinutes     Int      @default(60)
  slotIntervalMinutes Int      @default(30)
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  capacity            Int      @default(1)
  timezone            String   @default("Asia/Tehran")
  location            String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  weeklyRules  ServiceAvailabilityRule[]
  exceptions   ServiceDateException[]
  appointments Appointment[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, active])
}

// weekday uses JavaScript semantics: 0=Sunday … 6=Saturday. Minutes are
// counted from local midnight in Service.timezone.
model ServiceAvailabilityRule {
  id          String  @id @default(cuid())
  serviceId   String
  weekday     Int
  startMinute Int
  endMinute   Int
  capacity    Int?
  active      Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, weekday, startMinute, endMinute])
  @@index([serviceId, weekday, active])
}

// One exception per local date. `closed=true` is a blackout; otherwise the
// optional window replaces that day's weekly rules (capacity can also change).
model ServiceDateException {
  id          String   @id @default(cuid())
  serviceId   String
  date        DateTime @db.Date
  closed      Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  capacity    Int?
  note        String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([serviceId, date])
}

model Appointment {
  id                 String            @id @default(cuid())
  workspaceId        String
  serviceId          String
  contactId          String?
  customerName       String
  customerPhone      String?
  startsAt           DateTime
  endsAt             DateTime
  timezone           String            @default("Asia/Tehran")
  partySize          Int               @default(1)
  status             AppointmentStatus @default(CONFIRMED)
  source             String            @default("dashboard")
  idempotencyKey     String?
  notes              String?           @db.Text
  metadata           Json?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, startsAt])
  @@index([serviceId, startsAt, status])
  @@index([contactId, startsAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
