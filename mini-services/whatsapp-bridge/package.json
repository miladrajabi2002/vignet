{
  "name": "vigent-whatsapp-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp Web (Baileys) bridge for the vigent platform. Holds long-lived QR-login sessions and forwards inbound messages to the Next.js app.",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "start:bun": "bun --hot index.ts",
    "start:bun:prod": "bun index.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.1"
  }
}
