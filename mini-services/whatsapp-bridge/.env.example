# Port the bridge listens on.
WHATSAPP_BRIDGE_PORT=3040

# Where the Next.js app lives. The bridge POSTs inbound WhatsApp messages to
# `${NEXT_JS_BASE_URL}/api/webhook/whatsapp-qr`.
# In production: https://your-vigent-domain.tld
NEXT_JS_BASE_URL=http://localhost:3003

# Shared secret sent in the x-bridge-secret header in BOTH directions
# (Next.js → bridge on /start /status /send-text /disconnect,
#  bridge → Next.js on /api/webhook/whatsapp-qr). MUST match the same var in
# the Next.js .env. Generate one with:
#   openssl rand -hex 32
WHATSAPP_BRIDGE_SECRET=

# pino log level: silent | error | warn | info | debug
LOG_LEVEL=info
