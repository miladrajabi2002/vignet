{
	"name": "vigent",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20.19.0",
		"npm": ">=10"
	},
	"scripts": {
		"dev": "next dev -p 3003",
		"build": "node scripts/minify-widget.mjs && next build",
		"start": "next start -H 127.0.0.1 -p 3003",
		"check:production-env": "tsx scripts/check-production-env.ts",
		"lint": "next lint",
		"worker": "tsx worker/index.ts",
		"test": "vitest run",
		"test:agent-live": "tsx -r dotenv/config scripts/agent-live-smoke.ts",
		"test:agent-eval": "AGENT_SMOKE_EXTENDED=1 tsx -r dotenv/config scripts/agent-live-smoke.ts",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"plugin:zip": "node scripts/build-plugin-zip.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1075.0",
		"@prisma/client": "^6.19.3",
		"@ricky0123/vad-web": "^0.0.30",
		"bullmq": "^5.79.1",
		"framer-motion": "^12.42.0",
		"ioredis": "^5.11.1",
		"jalaali-js": "^2.0.0",
		"lucide-react": "^1.21.0",
		"next": "^15.5.20",
		"next-auth": "^5.0.0-beta.31",
		"next-intl": "^4.13.0",
		"pdf-parse": "^2.4.5",
		"qrcode": "^1.5.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"recharts": "^3.9.0",
		"resend": "^6.14.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@swc/helpers": "^0.5.23",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"dotenv": "^17.4.2",
		"eslint": "^8",
		"eslint-config-next": "^15.5.20",
		"postcss": "^8",
		"prisma": "^6.19.3",
		"tailwindcss": "^3.4.1",
		"terser": "^5.51.2",
		"tsx": "^4.22.4",
		"typescript": "^5",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"next": {
			"postcss": "8.5.20"
		}
	}
}
